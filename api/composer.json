{
    "name": "skazkin/auction",
    "description": "Auction App",
    "type": "project",
    "license": "BSD-3-Clause",
    "config": {
        "process-timeout": 0,
        "sort-packages": true
    },
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "doctrine/migrations": "^3.7",
        "doctrine/orm": "^2.20",
        "finesse/swiftmailer-defaults-plugin": "^2.0",
        "guzzlehttp/guzzle": "^7.8",
        "laminas/laminas-config-aggregator": "^1.14",
        "middlewares/negotiation": "^2.1",
        "monolog/monolog": "^3.6",
        "php-di/php-di": "^7.0",
        "ramsey/uuid": "^4.7",
        "sentry/sentry": "^4.7",
        "slim/psr7": "^1.6",
        "slim/slim": "^4.11",
        "swiftmailer/swiftmailer": "^6.0",
        "symfony/cache": "^6.3",
        "symfony/config": "^6.4",
        "symfony/console": "^6.2",
        "symfony/translation": "^6.4",
        "symfony/validator": "^6.4",
        "twig/twig": "^3.0",
        "webmozart/assert": "^1.11"
    },
    "require-dev": {
        "dms/phpunit-arraysubset-asserts": "^0.5.0",
        "doctrine/data-fixtures": "^2.0",
        "lctrs/psalm-psr-container-plugin": "^1.10",
        "overtrue/phplint": "^9.0",
        "phpunit/phpunit": "^10.5",
        "roave/security-advisories": "dev-latest",
        "squizlabs/php_codesniffer": "*",
        "vimeo/psalm": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Test\\": "tests/"
        }
    },
    "scripts": {
        "app": "@php bin/app.php --ansi",
        "doctrine": "@php bin/doctrine.php --ansi",
        "migrations": "@php bin/migrations.php --ansi",
        "lint": "phplint",
        "phpcs": "phpcs --standard=phpcs.xml",
        "phpcbf": "phpcbf --standard=phpcs.xml",
        "psalm": "psalm --config=psalm.xml",
        "test": "phpunit --colors=always",
        "test-coverage": "XDEBUG_MODE=coverage phpunit --colors=always --coverage-html var/test/coverage"
    }
}
